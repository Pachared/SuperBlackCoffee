{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@stackbuild/ui": ["../ui/src/index.tsx"],
      "@stackbuild/types": ["../types/src/index.ts"]
    }
  },
  "include": ["src", "../ui/src/assets.d.ts"]
}
