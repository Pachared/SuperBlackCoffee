{
  "name": "superblackcoffee",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "format": "prettier --write .",
    "clean": "rimraf apps/*/dist apps/*/.next",
    "dev:customer": "pnpm --filter @stackbuild/customer dev",
    "dev:website": "pnpm --filter @stackbuild/website dev",
    "build:customer": "pnpm --filter @stackbuild/customer build",
    "build:website": "pnpm --filter @stackbuild/website build",
    "lint:customer": "pnpm --filter @stackbuild/customer lint",
    "lint:website": "pnpm --filter @stackbuild/website lint",
    "dev:api": "cd apps/api && go run ./cmd/api",
    "build:api": "cd apps/api && go build ./cmd/api",
    "dev:admin": "pnpm --filter @stackbuild/admin dev",
    "dev:franchise": "pnpm --filter @stackbuild/franchise dev",
    "build:admin": "pnpm --filter @stackbuild/admin build",
    "build:franchise": "pnpm --filter @stackbuild/franchise build",
    "lint:admin": "pnpm --filter @stackbuild/admin lint",
    "lint:franchise": "pnpm --filter @stackbuild/franchise lint",
    "dev": "concurrently \"pnpm run dev:website\" \"pnpm run dev:customer\" \"cd apps/api && go run ./cmd/api\" \"pnpm run dev:admin\" \"pnpm run dev:franchise\"",
    "build": "pnpm run build:website && pnpm run build:customer && cd apps/api && go build ./cmd/api && pnpm run build:admin && pnpm run build:franchise",
    "lint": "pnpm run lint:website && pnpm run lint:customer && pnpm run lint:admin && pnpm run lint:franchise"
  },
  "devDependencies": {
    "concurrently": "latest",
    "prettier": "latest",
    "rimraf": "latest",
    "typescript": "6.0.3"
  }
}
