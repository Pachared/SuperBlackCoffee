{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@stackbuild/ui": ["../../packages/ui/src/index.tsx"],
      "@stackbuild/management": ["../../packages/management/src/index.ts"]
    }
  },
  "include": [
    "src",
    "../../packages/ui/src",
    "../../packages/management/src",
    "../../packages/types/src"
  ]
}
